# ---------------------------------------------------------------------------
# Reference material
# ---------------------------------------------------------------------------
# _ref/ holds a downloaded copy of the original TemplateMonster template's
# source (bootstrap.css, style.css, fonts.css, core.min.js, script.js). It is
# kept locally as the technical reference for this rebuild, but it is
# third-party commercial code and is not ours to redistribute — so it stays
# out of the repo. Delete this line if the repo is private and you want it
# versioned alongside the build.
_ref/


# ---------------------------------------------------------------------------
# Local QA scaffolding
# ---------------------------------------------------------------------------
# Throwaway harnesses used to drive the page in headless Chrome.
_qa*.html
_qa*.js
qa_dom.html
*.screenshot.png


# ---------------------------------------------------------------------------
# Dependencies / build output
# ---------------------------------------------------------------------------
# Nothing here is needed today — the site is plain HTML/CSS/JS with Bootstrap
# vendored into css/ and js/ — but these keep the repo clean if a bundler,
# linter or dev server is added later.
node_modules/
bower_components/
jspm_packages/
dist/
build/
.cache/
.parcel-cache/
.vite/
.temp/
.tmp/

package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
# The booking form is frontend-only today; when a real endpoint is wired up in
# js/forms.js, its credentials belong in an untracked env file.
.env
.env.*
!.env.example
*.pem
*.key


# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
*.swp
*.swo
*~


# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
# Thumbs.db / desktop.ini in particular show up inside assets/images/ on
# Windows as soon as the folder is browsed in Explorer.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

.directory
.fuse_hidden*
.nfs*


# ---------------------------------------------------------------------------
# Logs & misc
# ---------------------------------------------------------------------------
*.log
logs/
*.bak
*.orig
*.rej
